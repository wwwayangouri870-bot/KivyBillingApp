[app]

title = KivyBillingApp

package.name = kivybillingapp
package.domain = org.kivy

source.dir = .
source.include_exts = py,png,jpg,kv,atlas

version = 1.0

requirements = python3,kivy

orientation = portrait
fullscreen = 0

android.permissions = INTERNET

android.api = 35
android.minapi = 23
android.ndk = 25b

log_level = 2
warn_on_root = 1
